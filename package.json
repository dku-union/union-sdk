{
  "name": "union-sdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Union Mini-App SDK & CLI Tools",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:sdk": "npm run build -w packages/sdk",
    "build:cli": "npm run build -w packages/cli",
    "dev": "npm run dev -w packages/sdk",
    "test": "npm run test --workspaces",
    "clean": "rm -rf packages/*/dist"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
